{
  "name": "movie-ticketing-platform",
  "version": "1.0.0",
  "description": "Cloud-native microservices application for movie ticket booking",
  "main": "api-gateway.js",
  "scripts": {
    "start": "node api-gateway.js",
    "start:user": "node user-service.js",
    "start:movie": "node movie-service.js",
    "start:booking": "node booking-service.js",
    "start:payment": "node payment-service.js",
    "start:gateway": "node api-gateway.js",
    "dev": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f",
    "dev:down": "docker-compose down",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "test:load": "artillery run load-test.yml",
    "lint": "eslint .",
    "build": "docker build -t ticketing:latest .",
    "push": "docker push ticketing:latest",
    "deploy:k8s": "kubectl apply -f kubernetes-deployment.yaml",
    "deploy:aws": "scripts/deploy-aws.sh",
    "deploy:azure": "scripts/deploy-azure.sh",
    "deploy:gcp": "scripts/deploy-gcp.sh"
  },
  "keywords": [
    "microservices",
    "nodejs",
    "kubernetes",
    "docker",
    "cloud",
    "ticketing"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.3",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-http-proxy": "^2.1.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.3",
    "pg": "^8.10.0",
    "redis": "^4.6.5",
    "stripe": "^12.1.1",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "artillery": "^2.0.1",
    "docker-compose": "^1.3.1",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/movie-ticketing-platform.git"
  }
}
